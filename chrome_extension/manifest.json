{
  "manifest_version": 3,
  "name": "JobTracker",
  "version": "1.1",
  "description": "Follows LinkedIn's Apply button when a job is opened from the JobTracker dashboard, and lines up your open job tabs by resume fit.",
  "permissions": ["tabs"],
  "host_permissions": ["http://localhost:5050/*", "http://127.0.0.1:5050/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/view/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost:5050/*", "http://127.0.0.1:5050/*"],
      "js": ["dashboard_bridge.js"],
      "run_at": "document_start"
    }
  ]
}
